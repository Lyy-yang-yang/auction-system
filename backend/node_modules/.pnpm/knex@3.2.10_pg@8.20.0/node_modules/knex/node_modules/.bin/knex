#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/mnt/d/auction-system/backend/node_modules/.pnpm/knex@3.2.10_pg@8.20.0/node_modules/knex/node_modules:/mnt/d/auction-system/backend/node_modules/.pnpm/knex@3.2.10_pg@8.20.0/node_modules:/mnt/d/auction-system/backend/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/mnt/d/auction-system/backend/node_modules/.pnpm/knex@3.2.10_pg@8.20.0/node_modules/knex/node_modules:/mnt/d/auction-system/backend/node_modules/.pnpm/knex@3.2.10_pg@8.20.0/node_modules:/mnt/d/auction-system/backend/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/cli.js" "$@"
else
  exec node  "$basedir/../../bin/cli.js" "$@"
fi
